# ─── Firebase (required) ───────────────────────────────────────────────────
# For local development only. On Firebase App Hosting, credentials are
# supplied automatically (Application Default Credentials) — none of this
# block is needed there; see apphosting.yaml instead.
#
# Easiest local setup: download a service-account key from
#   Firebase console → Project settings → Service accounts → Generate new private key
# and point this at the downloaded file:
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
#
# Alternative: paste that file's whole JSON contents into one line here
# instead (useful if your host doesn't let you ship an extra file). If both
# are set, FIREBASE_SERVICE_ACCOUNT wins.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# <project-id>.firebasestorage.app — shown on the Storage page in the
# Firebase console once you've enabled it.
FIREBASE_STORAGE_BUCKET=""

# ─── Auth (required) ──────────────────────────────────────────────────────────
# Generate with:  npx auth secret     (or)   openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── One-tap sign-in providers (optional — buttons only appear if filled) ─────
# Google   → https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub   → https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Facebook → https://developers.facebook.com/apps
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# ─── AI provider (all options below are free) ─────────────────────────────────
# Leave everything blank and the app still runs on a built-in offline parser.
# In the deployed app, each student normally pastes their OWN key under
# Settings → AI instead — these env vars are only a server-wide fallback for
# whoever hasn't done that yet.
#
# Option A — Google Gemini free tier (recommended, best quality)
#   Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Option B — Groq free tier (very fast)
#   Get a key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Option C — Ollama, fully offline, LOCAL DEV ONLY. Install
# https://ollama.com then: ollama pull llama3.1 — this only works when the
# app itself is running on your machine; it can't be reached from a deployed
# App Hosting backend. Set AI_PROVIDER=ollama to use it.
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1"

# Option D — OpenAI (GPT). Paid, pennies per hundred parses.
#   Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Option E — Anthropic (Claude). Paid.
#   Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# Option F — OpenRouter. One key, many models, several free.
#   Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"

# Force a specific provider: gemini | groq | openai | anthropic | openrouter | ollama | heuristic
# Leave blank to auto-pick whichever key is present.
AI_PROVIDER=""
