# ─── Database (required) ──────────────────────────────────────────────────────
# A hosted Postgres connection string. Neon (neon.tech) has a genuinely free tier
# with no card required — create a project there and copy its POOLED connection
# string (the one with "-pooler" in the hostname; it's built for serverless
# functions like Vercel's, which open and close a database connection per request).
# Supabase's connection string works the same way if you'd rather use that.
DATABASE_URL="postgres://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# ─── Auth (required) ──────────────────────────────────────────────────────────
# Generate with:  npx auth secret     (or)   openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── One-tap sign-in providers (optional — buttons only appear if filled) ─────
# Google   → https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub   → https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─── AI provider (all options below are free) ─────────────────────────────────
# Leave everything blank and the app still runs on a built-in offline parser.
#
# Option A — Google Gemini free tier (recommended, best quality)
#   Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Option B — Groq free tier (very fast)
#   Get a key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Option C — Ollama, fully offline. Install https://ollama.com then: ollama pull llama3.1
#   Set AI_PROVIDER=ollama to use it.
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1"

# Option D — OpenAI (GPT). Paid, pennies per hundred parses.
#   Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Option E — Anthropic (Claude). Paid.
#   Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# Option F — OpenRouter. One key, many models, several free.
#   Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"

# Force a specific provider: gemini | groq | openai | anthropic | openrouter | ollama | heuristic
# Leave blank to auto-pick whichever key is present.
#
# NOTE: everything above is only a fallback. Once you save a provider and key in
# the app under Settings -> AI, that takes priority for your account.
AI_PROVIDER=""
